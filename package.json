{
  "name": "kysely-cursor",
  "version": "0.2.0",
  "type": "module",
  "description": "Cursor based pagination utils for Kysely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukewpc/kysely-cursor.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run --coverage --typecheck.enabled",
    "fix": "pnpm lint:fix && pnpm format:fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "example:postgres": "pnpm --filter kysely-cursor-example-postgres start",
    "bench": "pnpm --filter kysely-cursor-bench bench",
    "bench:quick": "pnpm --filter kysely-cursor-bench bench:quick",
    "bench:full": "pnpm --filter kysely-cursor-bench bench:full",
    "bench:ci": "pnpm --filter kysely-cursor-bench bench:ci",
    "bench:update-baseline": "pnpm --filter kysely-cursor-bench bench:update-baseline",
    "bench:compare": "pnpm --filter kysely-cursor-bench bench:compare",
    "bench:sqlite": "pnpm --filter kysely-cursor-bench bench:sqlite",
    "bench:postgres": "pnpm --filter kysely-cursor-bench bench:postgres",
    "bench:mysql": "pnpm --filter kysely-cursor-bench bench:mysql",
    "bench:mssql": "pnpm --filter kysely-cursor-bench bench:mssql"
  },
  "keywords": [
    "kysely",
    "pagination",
    "keyset",
    "cursor",
    "database",
    "sql"
  ],
  "author": "Luke Wood",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@testcontainers/mssqlserver": "^12.0.4",
    "@testcontainers/mysql": "^12.0.4",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "kysely": "^0.29.4",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.1",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "tarn": "^3.1.2",
    "tedious": "^20.0.0",
    "testcontainers": "^12.0.4",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "kysely": ">=0.28.6"
  }
}
