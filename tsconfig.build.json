{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "rootDir": "./src",
    "types": ["node"],
    "paths": {
      "~/*": ["./src/*"]
    },
    // tsup's DTS rollup still injects baseUrl; silence until tsup migrates (TS 6 deprecation).
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"]
}
