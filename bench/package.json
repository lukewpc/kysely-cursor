{
  "name": "kysely-cursor-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "tsx src/index.ts",
    "bench:quick": "tsx src/index.ts --quick",
    "bench:postgres": "tsx src/index.ts --dialect postgres",
    "bench:mysql": "tsx src/index.ts --dialect mysql",
    "bench:mssql": "tsx src/index.ts --dialect mssql",
    "bench:sqlite": "tsx src/index.ts --dialect sqlite"
  },
  "dependencies": {
    "@testcontainers/mssqlserver": "^12.0.4",
    "@testcontainers/mysql": "^12.0.4",
    "@testcontainers/postgresql": "^12.0.4",
    "better-sqlite3": "^12.11.1",
    "kysely": "^0.29.4",
    "kysely-cursor": "workspace:*",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.1",
    "pg": "^8.22.0",
    "tarn": "^3.1.2",
    "tedious": "^20.0.0",
    "testcontainers": "^12.0.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
